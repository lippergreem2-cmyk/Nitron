        "ethernet",
        "subnet",
        "network",
    ],
}


# Password alone is too generic to classify an image as
# cybersecurity. It is used only as a supporting signal.
WEAK_TOPIC_SIGNALS = {
    "cybersecurity": [
        "password",
        "passcode",
        "credential",
        "secret",
    ],
}


def detect_topics(text):
    """Detect likely topics from available text."""

    lowered = (text or "").lower()
    detected = []

    for topic, keywords in TOPICS.items():

        matches = []

        for keyword in keywords:
            if keyword.lower() in lowered:
                matches.append(keyword.strip())

        if matches:
            detected.append({
                "topic": topic,
                "matches": list(dict.fromkeys(matches)),
            })

    # Weak cybersecurity signals only count when accompanied
    # by another meaningful security/networking signal.
    weak_security = []

    for keyword in WEAK_TOPIC_SIGNALS["cybersecurity"]:
        if keyword in lowered:
            weak_security.append(keyword)

    strong_security = (
        any(
            item["topic"] == "cybersecurity"
            for item in detected
        )
        or any(
            item["topic"] == "wifi"
            for item in detected
        )
        or any(
            item["topic"] == "networking"
            for item in detected
        )
    )

    if weak_security and strong_security:
        existing = next(
            (
                item
                for item in detected
                if item["topic"] == "cybersecurity"
            ),
            None,
        )

        if existing:
            existing["matches"].extend(
                weak_security
            )
            existing["matches"] = list(
                dict.fromkeys(existing["matches"])
            )
        else:
            detected.append({
                "topic": "cybersecurity",
                "matches": weak_security,
            })

    return detected


# ==========================================================
# SEARCH QUERY
# ==========================================================

def build_search_query(
    text="",
    note="",
    topics=None,
):
    """
    Build a compact, privacy-conscious research query.

    When topic detection succeeds, topics are preferred over
    raw OCR because OCR may contain credentials, usernames,
    social-media text, or unrelated UI fragments.
    """

    topics = topics or []

    topic_names = []

    for item in topics[:3]:
        if isinstance(item, dict):
            topic = str(item.get("topic", "")).strip()

            if topic and topic not in topic_names:
                topic_names.append(topic)

    # Explicit user notes may provide useful research context.
    note_clean = re.sub(
        r"\s+",
        " ",
        note or "",
    ).strip()

    if topic_names:
        query = " ".join(topic_names)

        if note_clean:
            # Only use a short note; never append raw OCR.
            query += " " + note_clean[:150]

        return query[:300]

    # Fallback when no topics were detected.
    # Keep this conservative and never send raw OCR wholesale.
    cleaned = re.sub(
        r"https?://\S+|www\.\S+",
        " ",
        text or "",
        flags=re.IGNORECASE,
    )

    cleaned = re.sub(
        r"\b[\w.+-]+@[\w.-]+\.[A-Za-z]{2,}\b",
        " ",
        cleaned,
    )

    words = re.findall(
        r"[A-Za-z]{4,}",
        cleaned,
    )

    stop_words = {
        "password", "passcode", "credential", "secret",
        "generate", "strong", "random", "function",
        "characters", "return", "print", "output",
        "input", "project", "python", "import",
        "follow", "comment", "share", "save", "reels",
        "image", "screen", "withcode",
    }

    useful = []

    for word in words:
        lower = word.lower()

        if lower in stop_words:
            continue

        if lower not in {
            item.lower() for item in useful
        }:
            useful.append(word)

    query_parts = useful[:8]

    if note_clean:
        query_parts.insert(0, note_clean[:150])

    return " ".join(query_parts)[:300]


# ==========================================================
# INTERNET RESEARCH
# ==========================================================

def web_research(
    query,
    max_results=5,
):
    """
    Perform lightweight public web research.

    This supplements image understanding; it does not prove
    that information was visually recognized from the image.
    """

    if not query:

        return {
            "success": False,
            "query": "",
            "results": [],
            "error": "No research query available.",
        }

    if requests is None:

        return {
            "success": False,
            "query": query,
            "results": [],
            "error": (
                "Python requests is not installed."
            ),
        }

    url = (
        "https://html.duckduckgo.com/html/?q="
        + quote_plus(query)
    )

    try:

        response = requests.get(
            url,
            headers={
                "User-Agent": (
                    "Mozilla/5.0 "
                    "(Linux; Android) Nitron/3.0"
                )
            },
            timeout=SEARCH_TIMEOUT,
        )

        response.raise_for_status()

        html = response.text
        results = []

        pattern = re.compile(
            r'class="result__a"[^>]*href="([^"]+)"[^>]*>'
            r'(.*?)</a>',
            re.IGNORECASE | re.DOTALL,
        )

        blocked_phrases = (
            "cracking wifi",
            "wifi hacking",
            "password cracking",
            "crack wpa",
            "crack wpa2",
            "crack wpa3",
            "steal wifi",
            "break into wifi",
            "credential theft",
            "bypass authentication",
        )

        preferred_domains = (
            "cisa.gov",
            "nist.gov",
            "w3.org",
            "owasp.org",
            "microsoft.com",
            "developer.android.com",
            "python.org",
        )

        candidates = []

        for match in pattern.finditer(html):

            link = match.group(1)

            # DuckDuckGo may return redirect URLs containing
            # the actual destination in the "uddg" parameter.
            if link.startswith("//duckduckgo.com/"):
                parsed = urlparse("https:" + link)
                destination = parse_qs(
                    parsed.query
                ).get("uddg", [None])[0]

                if destination:
                    link = destination

            title = re.sub(
                r"<.*?>",
                "",
                match.group(2),
            )

            title = re.sub(
                r"\s+",
                " ",
                title,
            ).strip()

            if not title or not link:
                continue

            title_lower = title.lower()

            if any(
                phrase in title_lower
                for phrase in blocked_phrases
            ):
                continue

            candidates.append(
                {
                    "title": title,
                    "url": link,
                    "preferred": any(
                        domain in link.lower()
                        for domain in preferred_domains
                    ),
                }
            )

        # Prefer recognized educational/security authorities.
        candidates.sort(
            key=lambda item: item["preferred"],
            reverse=True,
        )

        for item in candidates[:max_results]:
            item.pop("preferred", None)
            results.append(item)

        return {
            "success": True,
            "query": query,
            "results": results,
            "error": "",
        }

    except Exception as error:

        return {
            "success": False,
            "query": query,
            "results": [],
            "error": str(error),
        }


