"""
Nitron Vision Analyzer v3

Capabilities:
- Image validation
- Image metadata
- OCR using Tesseract
- Real multimodal vision analysis through OpenAI
- Keyword/topic detection
- Optional public web research from OCR/user note
- Structured result suitable for Nitron learning memory

Environment:
    OPENAI_API_KEY       Required for OpenAI vision analysis.
    NITRON_VISION_MODEL  Optional. Defaults to gpt-5-mini.

The API key is intentionally NOT stored in this file.
"""

import base64
import json
import mimetypes
import os
import re
import subprocess
import urllib.error
import urllib.request
from datetime import datetime
from urllib.parse import quote_plus, urlparse, parse_qs

try:
    from brain.learner import learner
except ImportError:
    learner = None

try:
    from PIL import Image
except ImportError:
    Image = None

try:
    import requests
except ImportError:
    requests = None


TESSERACT = "tesseract"
SEARCH_TIMEOUT = 10

OPENAI_URL = "https://api.openai.com/v1/responses"
DEFAULT_VISION_MODEL = "gpt-5-mini"


# ==========================================================
# OPENAI VISION
# ==========================================================

def get_openai_key():
    """Return the OpenAI API key from the environment."""

    key = os.environ.get("OPENAI_API_KEY", "").strip()

    if not key:
        return None

    return key


def get_vision_model():
    """Return the configured vision model."""

    return os.environ.get(
        "NITRON_VISION_MODEL",
        DEFAULT_VISION_MODEL,
    ).strip() or DEFAULT_VISION_MODEL


def get_image_mime_type(image_path):
    """Determine the MIME type of an image."""

    mime_type, _ = mimetypes.guess_type(image_path)

    if mime_type and mime_type.startswith("image/"):
        return mime_type

    if Image is not None:
        try:
            with Image.open(image_path) as image:
                image_format = (image.format or "").upper()

            mapping = {
                "JPEG": "image/jpeg",
                "JPG": "image/jpeg",
                "PNG": "image/png",
                "WEBP": "image/webp",
                "GIF": "image/gif",
                "BMP": "image/bmp",
                "TIFF": "image/tiff",
            }

            if image_format in mapping:
                return mapping[image_format]

        except Exception:
            pass

    return "image/jpeg"


def encode_image_data_uri(image_path):
    """
    Read an image and convert it to a data URI suitable for
    multimodal OpenAI input.
    """

    with open(image_path, "rb") as image_file:
        image_bytes = image_file.read()

    encoded = base64.b64encode(image_bytes).decode("ascii")
    mime_type = get_image_mime_type(image_path)

    return f"data:{mime_type};base64,{encoded}"


def extract_openai_text(result):
    """Extract output text from a Responses API result."""

    output_text = result.get("output_text")

    if isinstance(output_text, str) and output_text.strip():
        return output_text.strip()

    parts = []

    for item in result.get("output", []):
        if not isinstance(item, dict):
            continue

        for content in item.get("content", []):
            if not isinstance(content, dict):
                continue

            if content.get("type") in (
                "output_text",
                "text",
            ):
                text = content.get("text", "")

                if isinstance(text, str) and text.strip():
                    parts.append(text.strip())

    return "\n".join(parts).strip()


def analyze_with_openai(
    image_path,
    note="",
):
    """
    Send the actual image to an OpenAI multimodal model.

    Returns a structured dictionary instead of pretending that OCR
    is equivalent to visual understanding.
    """

    api_key = get_openai_key()

    if not api_key:
        return {
            "success": False,
            "model": get_vision_model(),
            "analysis": "",
            "error": "OPENAI_API_KEY is not configured.",
        }

    try:
        image_data_uri = encode_image_data_uri(
            image_path
        )

    except Exception as error:
        return {
            "success": False,
            "model": get_vision_model(),
            "analysis": "",
            "error": f"Could not read image: {error}",
        }

    user_note = note.strip()

    prompt = """
Analyze the uploaded image carefully.

Give a useful description of what is visibly present.

Consider:
- objects and scenes
- readable text
- screenshots and interfaces
- diagrams
- documents
- signs and labels
- logos or symbols
- visible technical information
- relationships between visible elements
- anything else that is genuinely supported by the image

Do not invent details that cannot be reasonably seen.

If text is visible, transcribe the important text accurately.

If the image appears to show a technical or cybersecurity subject,
describe what is visibly shown and explain it at a high level.
Do not claim that an action was performed merely because an image
contains instructions or credentials.

If the user supplied a note, use it as context but distinguish
between what the note claims and what the image itself shows.

Return a clear, concise analysis suitable for an AI assistant.
""".strip()

    if user_note:
        prompt += (
            "\n\nUser's note:\n"
            + user_note
        )

    payload = {
        "model": get_vision_model(),
        "input": [
            {
                "role": "user",
                "content": [
                    {
                        "type": "input_text",
                        "text": prompt,
                    },
                    {
                        "type": "input_image",
                        "image_url": image_data_uri,
                    },
                ],
            }
        ],
    }

    data = json.dumps(
        payload
    ).encode("utf-8")

    request = urllib.request.Request(
        OPENAI_URL,
        data=data,
        headers={
            "Content-Type": "application/json",
            "Authorization": f"Bearer {api_key}",
        },
        method="POST",
    )

    try:
        with urllib.request.urlopen(
            request,
            timeout=120,
        ) as response:

            raw = response.read()

        result = json.loads(
            raw.decode("utf-8")
        )

        text = extract_openai_text(
            result
        )

        if not text:
            return {
                "success": False,
                "model": get_vision_model(),
                "analysis": "",
                "error": "OpenAI returned no vision analysis.",
            }

        return {
            "success": True,
            "model": get_vision_model(),
            "analysis": text,
            "error": "",
        }

    except urllib.error.HTTPError as error:

        body = error.read().decode(
            "utf-8",
            errors="replace",
        )

        # Give Nitron a clear, machine-readable result for
        # quota/billing failures instead of treating them like
        # an image or network failure.
        if error.code == 429:
            return {
                "success": False,
                "model": get_vision_model(),
                "analysis": "",
                "error_type": "quota_exceeded",
                "error": (
                    "OpenAI vision quota exceeded or billing "
                    "limit reached. The image pipeline is working, "
                    "but the OpenAI vision request cannot be completed."
                ),
                "api_error": body,
            }

        return {
            "success": False,
            "model": get_vision_model(),
            "analysis": "",
            "error_type": "api_error",
            "error": (
                f"OpenAI vision API error "
                f"{error.code}: {body}"
            ),
        }

    except urllib.error.URLError as error:

        return {
            "success": False,
            "model": get_vision_model(),
            "analysis": "",
            "error": (
                "Could not connect to OpenAI: "
                f"{error}"
            ),
        }

    except Exception as error:

        return {
            "success": False,
            "model": get_vision_model(),
            "analysis": "",
            "error": str(error),
        }


# ==========================================================
# OCR
# ==========================================================

def extract_text(image_path):
    """Extract visible text from an image using Tesseract."""

    try:
        process = subprocess.run(
            [
                TESSERACT,
                image_path,
                "stdout",
                "--psm",
                "6",
                "-l",
                "eng",
            ],
            capture_output=True,
            text=True,
            timeout=30,
        )

        if process.returncode != 0:
            return {
                "success": False,
                "text": "",
                "error": (
                    process.stderr.strip()
                    or "Tesseract OCR failed."
                ),
            }

        text = process.stdout.strip()

        return {
            "success": True,
            "text": text,
            "error": "",
        }

    except FileNotFoundError:

        return {
            "success": False,
            "text": "",
            "error": (
                "Tesseract is not installed "
                "or not in PATH."
            ),
        }

    except subprocess.TimeoutExpired:

        return {
            "success": False,
            "text": "",
            "error": "OCR timed out.",
        }

    except Exception as error:

        return {
            "success": False,
            "text": "",
            "error": str(error),
        }


