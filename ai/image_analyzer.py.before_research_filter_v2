# EXPLANATION
# ==========================================================

def generate_explanation(
    metadata,
    ocr_text="",
    topics=None,
    note="",
    vision=None,
):
    """
    Combine actual multimodal vision output with OCR and
    image metadata.
    """

    topics = topics or []
    lines = []

    lines.append(
        "Nitron's image analysis:"
    )

    if vision and vision.get("success"):

        lines.append(
            "Vision model analysis:"
        )

        lines.append(
            vision.get("analysis", "")
        )

    elif vision:

        lines.append(
            "Vision model unavailable:"
        )

        lines.append(
            vision.get(
                "error",
                "Unknown vision error.",
            )
        )

    if note:

        lines.append(
            f"User note: {note}"
        )

    if topics:

        names = ", ".join(
            item["topic"]
            for item in topics
        )

        lines.append(
            f"Detected topic(s): {names}."
        )

    if ocr_text:

        lines.append(
            "OCR also detected readable text:"
        )

        lines.append(
            ocr_text
        )

    width = metadata.get("width")
    height = metadata.get("height")

    image_format = metadata.get(
        "format"
    )

    mode = metadata.get(
        "mode"
    )

    if width and height:

        lines.append(
            f"Image size: {width}x{height}."
        )

    if image_format:

        lines.append(
            f"Format: {image_format}."
        )

    if mode:

        lines.append(
            f"Color mode: {mode}."
        )

    return "\n".join(
        lines
    )


# ==========================================================
# MAIN ANALYZER
# ==========================================================

def analyze_image(
    image_path,
    note="",
    research=False,
    learn=False,
):
    """
    Analyze an image with metadata, OCR, and a real
    multimodal vision model.
    """

    if not image_path:

        raise ValueError(
            "No image path supplied."
        )

    if not os.path.exists(image_path):

        raise FileNotFoundError(
            f"Image not found: {image_path}"
        )

    result = {
        "type": "image",
        "path": image_path,
        "filename": os.path.basename(
            image_path
        ),
        "size_bytes": os.path.getsize(
            image_path
        ),
        "analyzed_at": datetime.now().isoformat(),
        "user_note": note or "",
    }

    # ------------------------------------------------------
    # IMAGE METADATA
    # ------------------------------------------------------

    if Image is None:

        result["metadata_available"] = False

        result["metadata_error"] = (
            "Pillow is not installed."
        )

    else:

        try:

            with Image.open(
                image_path
            ) as image:

                result["metadata_available"] = True
                result["format"] = image.format
                result["width"] = image.width
                result["height"] = image.height
                result["mode"] = image.mode

        except Exception as error:

            result["metadata_available"] = False

            result["metadata_error"] = str(
                error
            )

    # ------------------------------------------------------
    # OCR
    # ------------------------------------------------------

    ocr = extract_text(
        image_path
    )

    result["ocr"] = ocr

    if ocr["success"]:
        result["text"] = ocr["text"]
    else:
        result["text"] = ""

    # ------------------------------------------------------
    # REAL MULTIMODAL VISION
    # ------------------------------------------------------

    vision = analyze_with_openai(
        image_path,
        note,
    )

    result["vision"] = vision

    # ------------------------------------------------------
    # TOPIC DETECTION
    # ------------------------------------------------------

    topic_text = (
        result.get("text", "")
        + " "
        + (note or "")
    )

    if vision.get("success"):

        topic_text += (
            " "
            + vision.get(
                "analysis",
                "",
            )
        )

    topics = detect_topics(
        topic_text
    )

    result["topics"] = topics

    # ------------------------------------------------------
    # EXPLANATION
    # ------------------------------------------------------

    result["explanation"] = (
        generate_explanation(
            result,
            result.get("text", ""),
            topics,
            note,
            vision,
        )
    )

    # ------------------------------------------------------
    # OPTIONAL INTERNET RESEARCH
    # ------------------------------------------------------

    result["research"] = {
        "performed": False,
        "query": "",
        "results": [],
        "error": "",
    }

    if research:

        research_source = (
            result.get("text", "")
        )

        if vision.get("success"):

            research_source += (
                " "
                + vision.get(
                    "analysis",
                    "",
                )
            )

        query = build_search_query(
            research_source,
            note,
            topics,
        )

        if query:

            research_result = web_research(
                query
            )

            research_result["performed"] = True

            result["research"] = (
                research_result
            )

    # ------------------------------------------------------
    # OPTIONAL LEARNING
    # ------------------------------------------------------
    result["learning"] = {
        "performed": False,
        "success": False,
        "topics": [],
        "error": "",
    }

    if learn and learner is not None:
        try:
            learned = learner.learn_image(
                result,
                source="image_analysis",
            )

            result["learning"] = {
                "performed": True,
                "success": True,
                "topics": [
                    entry.get("topic", "")
                    for entry in learned
                    if isinstance(entry, dict)
                ],
                "error": "",
            }

        except Exception as error:
            result["learning"] = {
                "performed": True,
                "success": False,
                "topics": [],
                "error": str(error),
            }

    # ------------------------------------------------------
    # FINAL SUMMARY
    # ------------------------------------------------------

    result["analysis"] = (
        result["explanation"]
    )

    return result


