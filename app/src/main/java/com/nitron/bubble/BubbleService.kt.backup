package com.nitron.bubble

import android.app.Service
import android.content.Intent
import android.graphics.*
import android.graphics.drawable.GradientDrawable
import android.os.Build
import android.os.Handler
import android.os.IBinder
import android.provider.Settings
import android.view.Gravity
import android.view.MotionEvent
import android.view.View
import android.view.WindowManager
import kotlin.math.abs
import kotlin.math.min

class BubbleService : Service() {

    companion object {
        @JvmStatic
        var isRunning: Boolean = false
            private set
    }

    private lateinit var windowManager: WindowManager
    private lateinit var bubbleView: NeonNitronView
    private lateinit var params: WindowManager.LayoutParams

    private var startX = 0
    private var startY = 0
    private var touchX = 0f
    private var touchY = 0f
    private var moved = false

    override fun onCreate() {
        super.onCreate()

        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.M &&
            !Settings.canDrawOverlays(this)
        ) {
            stopSelf()
            return
        }

        isRunning = true

        windowManager =
            getSystemService(WINDOW_SERVICE) as WindowManager

        bubbleView = NeonNitronView()

        val size = dp(420)

        params = WindowManager.LayoutParams(
            size,
            size,
            WindowManager.LayoutParams.TYPE_APPLICATION_OVERLAY,
            WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE or
                    WindowManager.LayoutParams.FLAG_LAYOUT_NO_LIMITS,
            PixelFormat.TRANSLUCENT
        )

        params.gravity = Gravity.TOP or Gravity.START
        params.x = dp(8)
        params.y = dp(150)

        try {
            windowManager.addView(bubbleView, params)
        } catch (_: Exception) {
            isRunning = false
            stopSelf()
            return
        }
    }

    private fun dp(value: Int): Int {
        return (value * resources.displayMetrics.density).toInt()
    }

    private fun openChat() {
        try {
            val intent = Intent(this, ChatActivity::class.java)
            intent.addFlags(
                Intent.FLAG_ACTIVITY_NEW_TASK or
                        Intent.FLAG_ACTIVITY_SINGLE_TOP
            )
            startActivity(intent)
        } catch (_: Exception) {
        }
    }

    private fun hideBubble() {
        stopSelf()
    }

    private fun keepInsideScreen() {
        val metrics = resources.displayMetrics

        val screenWidth = metrics.widthPixels
        val screenHeight = metrics.heightPixels

        val bubbleWidth = bubbleView.width
        val bubbleHeight = bubbleView.height

        val maxX = (screenWidth - bubbleWidth).coerceAtLeast(0)
        val maxY = (screenHeight - bubbleHeight).coerceAtLeast(0)

        params.x = params.x.coerceIn(0, maxX)
        params.y = params.y.coerceIn(0, maxY)
    }

    private fun snapToEdge() {
        val screenWidth = resources.displayMetrics.widthPixels
        val bubbleWidth = bubbleView.width

        params.x =
            if (
                params.x + bubbleWidth / 2 <
                screenWidth / 2
            ) {
                0
            } else {
                screenWidth - bubbleWidth
            }

        try {
            windowManager.updateViewLayout(
                bubbleView,
                params
            )
        } catch (_: Exception) {
        }
    }

    private inner class NeonNitronView : View(this@BubbleService) {

        private val density =
            resources.displayMetrics.density

        private val pink =
            Color.rgb(255, 35, 125)

        private val hotPink =
            Color.rgb(255, 75, 160)

        private val darkPink =
            Color.rgb(48, 0, 20)

        private val white =
            Color.rgb(255, 225, 240)

        private val paint =
            Paint(Paint.ANTI_ALIAS_FLAG)

        private val glowPaint =
            Paint(Paint.ANTI_ALIAS_FLAG)

        private val handler =
            Handler(mainLooper)

        private var pressTime = 0L

        private fun d(v: Float): Float {
            return v * density
        }

        init {
            setLayerType(View.LAYER_TYPE_SOFTWARE, null)
            isClickable = true
        }

        override fun onDraw(canvas: Canvas) {
            super.onDraw(canvas)

            val w = width.toFloat()
            val h = height.toFloat()

            canvas.drawColor(Color.TRANSPARENT)

            val cx = w * 0.48f
            val cy = h * 0.50f

            val radius =
                min(w, h) * 0.285f

            // =================================================
            // SPEECH BUBBLE
            // =================================================

            drawSpeechBubble(
                canvas,
                w * 0.08f,
                h * 0.025f,
                w * 0.78f,
                h * 0.205f
            )

            // =================================================
            // MAIN NEON ORB
            // =================================================

            drawOrb(
                canvas,
                cx,
                cy + h * 0.025f,
                radius
            )

            // =================================================
            // TOP LEFT MENU BUTTON
            // =================================================

            drawCircleButton(
                canvas,
                w * 0.13f,
                h * 0.245f,
                d(25f),
                "menu"
            )

            // =================================================
            // TOP RIGHT X
            // =================================================

            drawCircleButton(
                canvas,
                w * 0.86f,
                h * 0.245f,
                d(25f),
                "x"
            )

            // =================================================
            // MICROPHONE
            // =================================================

            drawCircleButton(
                canvas,
                w * 0.18f,
                h * 0.78f,
                d(28f),
                "mic"
            )

            // =================================================
            // RIGHT WAVEFORM
            // =================================================

            drawCircleButton(
                canvas,
                w * 0.83f,
                h * 0.48f,
                d(25f),
                "wave"
            )

            // =================================================
            // RIGHT MENU PANEL
            // =================================================

            drawMenuPanel(
                canvas,
                w * 0.72f,
                h * 0.58f,
                w * 0.98f,
                h * 0.92f
            )

            // =================================================
            // DRAG HANDLE
            // =================================================

            drawDragHandle(
                canvas,
                w * 0.30f,
                h * 0.91f,
                w * 0.66f,
                h * 0.985f
            )
        }

        private fun drawSpeechBubble(
            canvas: Canvas,
            left: Float,
            top: Float,
            right: Float,
            bottom: Float
        ) {
            val rect =
                RectF(left, top, right, bottom)

            paint.style = Paint.Style.FILL
            paint.color = Color.argb(220, 45, 0, 22)

            canvas.drawRoundRect(
                rect,
                d(22f),
                d(22f),
                paint
            )

            paint.style = Paint.Style.STROKE
            paint.strokeWidth = d(2f)
            paint.color = hotPink
            paint.setShadowLayer(
                d(10f),
                0f,
                0f,
                pink
            )

            canvas.drawRoundRect(
                rect,
                d(22f),
                d(22f),
                paint
            )

            paint.clearShadowLayer()

            // Speech tail
            val path = Path()

            path.moveTo(
                left + (right - left) * 0.43f,
                bottom
            )

            path.lineTo(
                left + (right - left) * 0.49f,
                bottom + d(22f)
            )

            path.lineTo(
                left + (right - left) * 0.55f,
                bottom
            )

            path.close()

            paint.style = Paint.Style.FILL
            paint.color = Color.argb(220, 45, 0, 22)

            canvas.drawPath(path, paint)

            paint.style = Paint.Style.STROKE
            paint.strokeWidth = d(2f)
            paint.color = hotPink

            canvas.drawPath(path, paint)

            drawCenteredText(
                canvas,
                "Hello, I'm Nitron",
                (left + right) / 2f,
                top + d(38f),
                d(18f),
                white
            )

            drawCenteredText(
                canvas,
                "How can I help you?",
                (left + right) / 2f,
                top + d(65f),
                d(16f),
                white
            )

            drawCenteredText(
                canvas,
                "• • •",
                (left + right) / 2f,
                top + d(94f),
                d(16f),
                hotPink
            )
        }

        private fun drawOrb(
            canvas: Canvas,
            cx: Float,
            cy: Float,
            radius: Float
        ) {
            // Outer glow
            glowPaint.style = Paint.Style.FILL
            glowPaint.shader =
                RadialGradient(
                    cx,
                    cy,
                    radius * 1.5f,
                    intArrayOf(
                        Color.argb(130, 255, 20, 110),
                        Color.argb(65, 255, 20, 110),
                        Color.argb(0, 255, 20, 110)
                    ),
                    floatArrayOf(
                        0f,
                        0.65f,
                        1f
                    ),
                    Shader.TileMode.CLAMP
                )

            canvas.drawCircle(
                cx,
                cy,
                radius * 1.5f,
                glowPaint
            )

            // Orb interior
            paint.style = Paint.Style.FILL
            paint.shader =
                RadialGradient(
                    cx - radius * 0.25f,
                    cy - radius * 0.25f,
                    radius * 1.15f,
                    intArrayOf(
                        Color.rgb(105, 0, 40),
                        Color.rgb(45, 0, 20),
                        Color.rgb(15, 0, 8)
                    ),
                    null,
                    Shader.TileMode.CLAMP
                )

            canvas.drawCircle(
                cx,
                cy,
                radius,
                paint
            )

            paint.shader = null

            // Outer rings
            for (i in 0..5) {

                val r =
                    radius * (0.82f + i * 0.075f)

                paint.style = Paint.Style.STROKE
                paint.strokeWidth =
                    if (i == 0) d(2.2f) else d(0.7f)

                paint.color =
                    Color.argb(
                        160 - i * 18,
                        255,
                        30,
                        125
                    )

                paint.setShadowLayer(
                    d(5f),
                    0f,
                    0f,
                    pink
                )

                canvas.drawCircle(
                    cx,
                    cy,
                    r,
                    paint
                )

                paint.clearShadowLayer()
            }

            // Orbit ellipse 1
            drawOrbit(
                canvas,
                cx,
                cy,
                radius,
                -0.35f
            )

            // Orbit ellipse 2
            drawOrbit(
                canvas,
                cx,
                cy,
                radius,
                0.35f
            )

            // Orbit ellipse 3
            drawOrbit(
                canvas,
                cx,
                cy,
                radius,
                1.05f
            )

            // Center N
            drawCenteredText(
                canvas,
                "N",
                cx,
                cy + d(18f),
                d(70f),
                hotPink,
                true
            )

            drawCenteredText(
                canvas,
                "NITRON",
                cx,
                cy + d(67f),
                d(25f),
                hotPink,
                true
            )
        }

        private fun drawOrbit(
            canvas: Canvas,
            cx: Float,
            cy: Float,
            radius: Float,
            rotation: Float
        ) {
            canvas.save()

            canvas.rotate(
                Math.toDegrees(rotation.toDouble()).toFloat(),
                cx,
                cy
            )

            val oval =
                RectF(
                    cx - radius * 1.18f,
                    cy - radius * 0.36f,
                    cx + radius * 1.18f,
                    cy + radius * 0.36f
                )

            paint.style = Paint.Style.STROKE
            paint.strokeWidth = d(1.1f)
            paint.color = Color.argb(
                180,
                255,
                40,
                135
            )

            paint.setShadowLayer(
                d(5f),
                0f,
                0f,
                pink
            )

            canvas.drawOval(
                oval,
                paint
            )

            paint.clearShadowLayer()

            // glowing orbit point
            paint.style = Paint.Style.FILL
            paint.color = hotPink
            paint.setShadowLayer(
                d(8f),
                0f,
                0f,
                pink
            )

            canvas.drawCircle(
                cx + radius * 0.82f,
                cy,
                d(4f),
                paint
            )

            paint.clearShadowLayer()

            canvas.restore()
        }

        private fun drawCircleButton(
            canvas: Canvas,
            cx: Float,
            cy: Float,
            radius: Float,
            type: String
        ) {
            paint.style = Paint.Style.FILL
            paint.color = Color.argb(
                210,
                35,
                0,
                18
            )

            paint.setShadowLayer(
                d(10f),
                0f,
                0f,
                pink
            )

            canvas.drawCircle(
                cx,
                cy,
                radius,
                paint
            )

            paint.clearShadowLayer()

            paint.style = Paint.Style.STROKE
            paint.strokeWidth = d(2f)
            paint.color = hotPink

            canvas.drawCircle(
                cx,
                cy,
                radius,
                paint
            )

            paint.style = Paint.Style.STROKE
            paint.strokeWidth = d(3f)
            paint.strokeCap = Paint.Cap.ROUND
            paint.color = hotPink

            when (type) {

                "menu" -> {
                    for (i in -1..1) {
                        val y =
                            cy + i * d(7f)

                        canvas.drawLine(
                            cx - d(9f),
                            y,
                            cx + d(9f),
                            y,
                            paint
                        )
                    }
                }

                "x" -> {
                    canvas.drawLine(
                        cx - d(9f),
                        cy - d(9f),
                        cx + d(9f),
                        cy + d(9f),
                        paint
                    )

                    canvas.drawLine(
                        cx + d(9f),
                        cy - d(9f),
                        cx - d(9f),
                        cy + d(9f),
                        paint
                    )
                }

                "mic" -> {
                    paint.style = Paint.Style.FILL

                    val mic =
                        RectF(
                            cx - d(7f),
                            cy - d(13f),
                            cx + d(7f),
                            cy + d(5f)
                        )

                    canvas.drawRoundRect(
                        mic,
                        d(7f),
                        d(7f),
                        paint
                    )

                    paint.style = Paint.Style.STROKE
                    paint.strokeWidth = d(2f)

                    canvas.drawArc(
                        RectF(
                            cx - d(13f),
                            cy - d(5f),
                            cx + d(13f),
                            cy + d(14f)
                        ),
                        0f,
                        180f,
                        false,
                        paint
                    )

                    canvas.drawLine(
                        cx,
                        cy + d(14f),
                        cx,
                        cy + d(20f),
                        paint
                    )

                    canvas.drawLine(
                        cx - d(7f),
                        cy + d(20f),
                        cx + d(7f),
                        cy + d(20f),
                        paint
                    )
                }

                "wave" -> {
                    val heights =
                        floatArrayOf(
                            5f,
                            12f,
                            19f,
                            12f,
                            5f
                        )

                    for (i in heights.indices) {
                        val x =
                            cx + (i - 2) * d(6f)

                        val hh =
                            d(heights[i])

                        canvas.drawLine(
                            x,
                            cy - hh,
                            x,
                            cy + hh,
                            paint
                        )
                    }
                }
            }

            paint.strokeCap = Paint.Cap.BUTT
        }

        private fun drawMenuPanel(
            canvas: Canvas,
            left: Float,
            top: Float,
            right: Float,
            bottom: Float
        ) {
            val rect =
                RectF(left, top, right, bottom)

            paint.style = Paint.Style.FILL
            paint.color =
                Color.argb(
                    235,
                    35,
                    0,
                    20
                )

            paint.setShadowLayer(
                d(14f),
                0f,
                0f,
                pink
            )

            canvas.drawRoundRect(
                rect,
                d(20f),
                d(20f),
                paint
            )

            paint.clearShadowLayer()

            paint.style = Paint.Style.STROKE
            paint.strokeWidth = d(2f)
            paint.color = hotPink

            canvas.drawRoundRect(
                rect,
                d(20f),
                d(20f),
                paint
            )

            val items =
                arrayOf(
                    "Talk to Nitron",
                    "Take Screenshot",
                    "Open Apps",
                    "Scan QR Code",
                    "Settings"
                )

            val icons =
                arrayOf(
                    "▢",
                    "▣",
                    "⊞",
                    "⌗",
                    "⚙"
                )

            val rowHeight =
                (bottom - top) / 5.2f

            for (i in items.indices) {

                val y =
                    top +
                            rowHeight * i +
                            rowHeight * 0.58f

                drawText(
                    canvas,
                    icons[i],
                    left + d(17f),
                    y,
                    d(19f),
                    hotPink,
                    true
                )

                drawText(
                    canvas,
                    items[i],
                    left + d(48f),
                    y,
                    d(12.5f),
                    white,
                    false
                )
            }
        }

        private fun drawDragHandle(
            canvas: Canvas,
            left: Float,
            top: Float,
            right: Float,
            bottom: Float
        ) {
            val rect =
                RectF(
                    left,
                    top,
                    right,
                    bottom
                )

            paint.style = Paint.Style.FILL
            paint.color =
                Color.argb(
                    230,
                    40,
                    0,
                    20
                )

            paint.setShadowLayer(
                d(10f),
                0f,
                0f,
                pink
            )

            canvas.drawRoundRect(
                rect,
                d(25f),
                d(25f),
                paint
            )

            paint.clearShadowLayer()

            paint.style = Paint.Style.STROKE
            paint.strokeWidth = d(2f)
            paint.color = hotPink

            canvas.drawRoundRect(
                rect,
                d(25f),
                d(25f),
                paint
            )

            drawCenteredText(
                canvas,
                "Drag to Move",
                (left + right) / 2f,
                top + d(30f),
                d(14f),
                hotPink,
                true
            )
        }

        private fun drawText(
            canvas: Canvas,
            text: String,
            x: Float,
            y: Float,
            size: Float,
            color: Int,
            bold: Boolean
        ) {
            paint.style = Paint.Style.FILL
            paint.color = color
            paint.textSize = size
            paint.typeface =
                if (bold) {
                    Typeface.create(
                        Typeface.DEFAULT,
                        Typeface.BOLD
                    )
                } else {
                    Typeface.DEFAULT
                }

            paint.setShadowLayer(
                d(4f),
                0f,
                0f,
                pink
            )

            canvas.drawText(
                text,
                x,
                y,
                paint
            )

            paint.clearShadowLayer()
        }

        private fun drawCenteredText(
            canvas: Canvas,
            text: String,
            x: Float,
            y: Float,
            size: Float,
            color: Int,
            bold: Boolean = false
        ) {
            paint.style = Paint.Style.FILL
            paint.color = color
            paint.textSize = size
            paint.typeface =
                if (bold) {
                    Typeface.create(
                        Typeface.DEFAULT,
                        Typeface.BOLD
                    )
                } else {
                    Typeface.DEFAULT
                }

            paint.textAlign = Paint.Align.CENTER

            paint.setShadowLayer(
                d(5f),
                0f,
                0f,
                pink
            )

            canvas.drawText(
                text,
                x,
                y,
                paint
            )

            paint.clearShadowLayer()
            paint.textAlign = Paint.Align.LEFT
        }

        override fun onTouchEvent(
            event: MotionEvent
        ): Boolean {

            when (event.actionMasked) {

                MotionEvent.ACTION_DOWN -> {

                    startX = params.x
                    startY = params.y

                    touchX = event.rawX
                    touchY = event.rawY

                    moved = false
                    pressTime =
                        System.currentTimeMillis()

                    return true
                }

                MotionEvent.ACTION_MOVE -> {

                    val dx =
                        event.rawX - touchX

                    val dy =
                        event.rawY - touchY

                    if (
                        abs(dx) > d(8f) ||
                        abs(dy) > d(8f)
                    ) {
                        moved = true
                    }

                    params.x =
                        startX + dx.toInt()

                    params.y =
                        startY + dy.toInt()

                    keepInsideScreen()

                    try {
                        windowManager.updateViewLayout(
                            this,
                            params
                        )
                    } catch (_: Exception) {
                    }

                    return true
                }

                MotionEvent.ACTION_UP -> {

                    val duration =
                        System.currentTimeMillis() -
                                pressTime

                    if (moved) {
                        snapToEdge()
                        return true
                    }

                    // X area
                    if (
                        event.x > width * 0.76f &&
                        event.y < height * 0.33f
                    ) {
                        hideBubble()
                        return true
                    }

                    // Main orb
                    val cx = width * 0.48f
                    val cy = height * 0.525f

                    val dx =
                        event.x - cx

                    val dy =
                        event.y - cy

                    val distance =
                        kotlin.math.sqrt(
                            dx * dx + dy * dy
                        )

                    if (distance < width * 0.34f) {
                        openChat()
                        return true
                    }

                    // Microphone button
                    if (
                        event.x < width * 0.35f &&
                        event.y > height * 0.68f
                    ) {
                        openChat()
                        return true
                    }

                    // Talk to Nitron menu
                    if (
                        event.x > width * 0.70f &&
                        event.y > height * 0.55f
                    ) {
                        openChat()
                        return true
                    }

                    return true
                }

                MotionEvent.ACTION_CANCEL -> {
                    if (moved) {
                        snapToEdge()
                    }
                    return true
                }
            }

            return true
        }
    }

    override fun onDestroy() {

        isRunning = false

        if (::bubbleView.isInitialized) {
            try {
                windowManager.removeView(
                    bubbleView
                )
            } catch (_: Exception) {
            }
        }

        super.onDestroy()
    }

    override fun onBind(
        intent: Intent?
    ): IBinder? {
        return null
    }
}
