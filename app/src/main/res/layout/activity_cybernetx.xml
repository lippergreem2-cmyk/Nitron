<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@color/nitron_background">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="CYBERNET X"
        android:textSize="25sp"
        android:textStyle="bold"
        android:paddingBottom="8dp"/>

    <Spinner
        android:id="@+id/languageSpinner"
        android:layout_width="match_parent"
        android:layout_height="48dp"/>

    <TextView
        android:id="@+id/progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Lesson 1"
        android:textSize="14sp"
        android:paddingTop="8dp"/>

    <TextView
        android:id="@+id/lessonTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="21sp"
        android:textStyle="bold"
        android:paddingTop="10dp"
        android:paddingBottom="6dp"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/lessonText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:paddingBottom="12dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="YOUR CODE"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/codeEditor"
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:gravity="top|start"
                android:inputType="textMultiLine"
                android:fontFamily="monospace"
                android:textSize="14sp"
                android:padding="12dp"
                android:background="@drawable/nitron_input_background"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="10dp">

                <Button
                    android:id="@+id/runButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Run"/>

                <Button
                    android:id="@+id/checkButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Check"/>
            </LinearLayout>

            <Button
                android:id="@+id/hintButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Hint"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="OUTPUT"
                android:textStyle="bold"
                android:paddingTop="10dp"/>

            <TextView
                android:id="@+id/output"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:gravity="top|start"
                android:fontFamily="monospace"
                android:padding="12dp"
                android:text="Output will appear here..."
                android:background="@drawable/nitron_input_background"/>

            <Button
                android:id="@+id/nextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Next Lesson"/>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
