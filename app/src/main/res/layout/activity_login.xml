<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="40dp"
        android:paddingBottom="40dp">

        <ImageView
            android:layout_width="78dp"
            android:layout_height="78dp"
            android:src="@drawable/nitron_icon"
            android:contentDescription="Nitron" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Welcome to Nitron"
            android:textSize="29sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:gravity="center"
            android:text="Your AI assistant for chat, projects and more."
            android:textSize="16sp"
            android:alpha="0.7" />

        <Button
            android:id="@+id/googleLoginButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="38dp"
            android:text="Continue with Google"
            android:textSize="16sp"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/appleLoginButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:text="Continue with Apple"
            android:textSize="16sp"
            android:textAllCaps="false" />

        <TextView
            android:id="@+id/loginStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text=""
            android:textSize="14sp"
            android:alpha="0.7" />

    </LinearLayout>

</ScrollView>
