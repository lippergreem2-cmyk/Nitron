<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <!-- HEADER -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="16dp">

            <TextView
                android:id="@+id/settingsBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="‹"
                android:textSize="34sp"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Settings"
                android:textSize="22sp"
                android:textStyle="bold"/>

        </LinearLayout>

        <!-- GENERAL -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingTop="18dp"
            android:paddingBottom="8dp"
            android:text="⚙  General"
            android:textSize="14sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/systemMode"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:paddingStart="28dp"
            android:text="System theme"
            android:textSize="16sp"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/lightMode"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:paddingStart="28dp"
            android:text="☀  Light mode"
            android:textSize="16sp"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/darkMode"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:paddingStart="28dp"
            android:text="☾  Dark mode"
            android:textSize="16sp"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/languageSetting"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:paddingStart="28dp"
            android:text="Language"
            android:textSize="16sp"/>

        <TextView
            android:id="@+id/notificationsSetting"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:paddingStart="28dp"
            android:text="Notifications"
            android:textSize="16sp"/>

        <!-- CHAT -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingTop="18dp"
            android:paddingBottom="8dp"
            android:text="💬  Chat"
            android:textSize="14sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/newChatSetting"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:paddingStart="28dp"
            android:text="New chat behavior"
            android:textSize="16sp"/>

        <TextView
            android:id="@+id/enterSendSetting"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:paddingStart="28dp"
            android:text="Enter to send"
            android:textSize="16sp"/>

        <TextView
            android:id="@+id/clearConversationSetting"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:paddingStart="28dp"
            android:text="Clear conversation"
            android:textSize="16sp"/>

        <!-- TOOLS -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingTop="18dp"
            android:paddingBottom="8dp"
            android:text="🛠  Tools"
            android:textSize="14sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/myLocationSetting"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:paddingStart="28dp"
            android:text="📍  My Location"
            android:textSize="16sp"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/startBubbleSetting"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:paddingStart="28dp"
            android:text="🫧  Start Bubble"
            android:textSize="16sp"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/voiceLanguageSetting"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:paddingStart="28dp"
            android:text="🌐  Voice language"
            android:textSize="16sp"
            android:clickable="true"
            android:focusable="true"/>

        <!-- ACCOUNT -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingTop="18dp"
            android:paddingBottom="8dp"
            android:text="👤  Account"
            android:textSize="14sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/signOutSetting"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:paddingStart="28dp"
            android:text="Sign out"
            android:textSize="16sp"
            android:clickable="true"
            android:focusable="true"/>

    </LinearLayout>

</ScrollView>
