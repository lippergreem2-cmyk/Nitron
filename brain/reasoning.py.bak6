                    "path": "style.css",
                    "content": """body {
    font-family: Arial, sans-serif;
    margin: 0;
    padding: 40px;
}

#app {
    max-width: 900px;
    margin: auto;
}

button {
    padding: 10px 20px;
    cursor: pointer;
}
"""
                },
                {
                    "path": "script.js",
                    "content": f"""const button = document.getElementById("actionButton");
const output = document.getElementById("output");

button.addEventListener("click", () => {{
    output.textContent = "{name} is working!";
}});
"""
                },
                {
                    "path": "README.md",
                    "content": f"""# {name}

Web application generated by Nitron.

Open index.html in a web browser.
"""
                }
            ]

        elif project_type == "calculator":
            files = [
                {
                    "path": "main.py",
                    "content": f"""# {name}
# Generated by Nitron

def calculator():
    print("{name}")
    print("1. Add")
    print("2. Subtract")
    print("3. Multiply")
    print("4. Divide")

    first = float(input("First number: "))
    operator = input("Operation (+, -, *, /): ")
    second = float(input("Second number: "))

    if operator == "+":
        result = first + second
    elif operator == "-":
        result = first - second
    elif operator == "*":
        result = first * second
    elif operator == "/":
        if second == 0:
            print("Cannot divide by zero.")
            return
        result = first / second
