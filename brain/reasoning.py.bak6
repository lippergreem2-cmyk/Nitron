    padding: 40px;
}

main {
    max-width: 900px;
    margin: auto;
}
"""
                },
                {
                    "path": "script.js",
                    "content": f"""console.log("{name} loaded.");
"""
                },
                {
                    "path": "README.md",
                    "content": f"""# {name}

Website generated by Nitron.

Open index.html in a web browser.
"""
                }
            ]

        elif project_type == "web_app":
            files = [
                {
                    "path": "index.html",
                    "content": f"""<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
