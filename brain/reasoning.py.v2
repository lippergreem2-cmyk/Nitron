"""
Nitron Reasoning Engine
"""

import re

from brain.memory import memory

try:
    from brain.knowledge_engine import knowledge
except ImportError:
    knowledge = None

try:
    from brain.learner import learner
except ImportError:
    learner = None

try:
    from brain.search_engine import search_engine
except ImportError:
    search_engine = None


class ReasoningEngine:

    def __init__(self):
        self.name = "Nitron Reasoning Engine"

    def analyze(self, command):
        """
        Analyze a command and classify its intent.
        """

        command = command.lower().strip()

        categories = {

            "academy": [
                "teach",
                "learn",
                "lesson",
                "academy",
                "study"
            ],

            "developer": [
                "build",
                "create",
                "generate",
                "project",
                "website",
                "app",
                "code",
                "program"
            ],

            "trading": [
                "trade",
                "gold",
                "forex",
                "bitcoin",
                "crypto",
                "market"
            ],

            "weather": [
                "weather",
                "forecast"
            ],

            "music": [
                "music",
                "song",
                "play"
            ],

            "system": [
                "time",
                "date"
            ]
        }

        for category, words in categories.items():

            if any(word in command for word in words):
                return category

        return "chat"

    def explain(self, topic):
        """
        Search the built-in knowledge base.
        """

        if knowledge is None:
            return "Knowledge engine is unavailable."

        result = knowledge.get_category(topic)

        if result:
            return result

        return f"I don't know enough about '{topic}'."

    def search_learned(self, keyword):
        """
        Search learned knowledge using meaningful words
        instead of requiring the entire question to match.
        """

        if learner is None:
            return {}

        if not keyword:
            return {}

        text = str(keyword).lower().strip()

        # Remove common question words.
        stop_words = {
            "what",
            "what's",
            "whats",
            "is",
            "are",
            "am",
            "an",
            "a",
            "the",
            "tell",
            "me",
            "about",
            "explain",
            "describe",
            "who",
            "how",
            "why",
            "where",
            "when",
            "can",
            "you",
            "please",
            "do",
            "does",
            "did",
            "this",
            "that",
            "it",
            "to",
            "of",
            "for",
            "in",
            "on",
            "and"
        }

        words = re.findall(
            r"[a-zA-Z0-9_]+",
            text
        )

        words = [
            word
            for word in words
            if word not in stop_words
            and len(word) >= 2
        ]

        if not words:
            return {}

        results = {}

        for topic, data in learner.knowledge.items():

            searchable = str(data).lower()
            topic_text = str(topic).lower()

            score = 0

            for word in words:

                if word == topic_text:
                    score += 10

                elif word in topic_text:
                    score += 6

                if word in searchable:
                    score += 2

            if score > 0:

                results[topic] = {
                    "score": score,
                    "data": data
                }

        if not results:
            return {}

        # Best matches first.
        ordered = dict(
            sorted(
                results.items(),
                key=lambda item: item[1]["score"],
                reverse=True
            )
        )

        # Return the original knowledge structure,
        # without exposing internal scores.
        return {
            topic: item["data"]
            for topic, item in ordered.items()
        }

    def answer(self, question):
        """
        Answer using learned knowledge first,
        then existing search and built-in knowledge.
        """

        # --------------------------------------------------
        # 1. Learned knowledge
        # --------------------------------------------------

        learned = self.search_learned(question)

        if learned:

            # Prefer the strongest learned result.
            topic = next(iter(learned))
            data = learned[topic]

            return {
                "source": "learned_knowledge",
                "topic": topic,
                "title": data.get("title", ""),
                "summary": data.get(
                    "summary",
                    data.get("content", "")
                ),
                "keywords": data.get(
                    "keywords",
                    []
                )
            }

        # --------------------------------------------------
        # 2. Existing external search
        # --------------------------------------------------

        if search_engine:

            try:

                results = search_engine.search(
                    question
                )

                if results:
                    return results

            except Exception:
                pass

        # --------------------------------------------------
        # 3. Built-in knowledge
        # --------------------------------------------------

        if knowledge:

            try:

                built_in = knowledge.get_category(
                    question
                )

                if built_in:
                    return built_in

            except Exception:
                pass

        # --------------------------------------------------
        # 4. Nothing found
        # --------------------------------------------------

        return {
            "message":
                "I haven't learned enough about that yet."
        }

    def think(self, question):
        """
        Alias for answer().
        """

        return self.answer(question)

    def learn_topic(self, topic, url):
        """
        Learn from a website.
        """

        try:

            from brain.study import study_engine

            return study_engine.study(
                topic,
                url
            )

        except Exception as e:

            return str(e)

    def remember_fact(self, key, value):
        """
        Store a fact.
        """

        memory.remember(
            key,
            value
        )

        return "Fact remembered."

    def recall_fact(self, key):
        """
        Recall a stored fact.
        """

        return memory.recall(
            key,
            "I don't remember that."
        )

    def compare(self, first, second):
        """
        Compare two values.
        """

        if first == second:
            return "They are the same."

        return "They are different."

    def status(self):
        """
        Return Nitron brain status.
        """

        learned = 0

        if learner:
            learned = len(
                learner.knowledge
            )

        return {
            "name": self.name,
            "knowledge_loaded": knowledge is not None,
            "learning_enabled": learner is not None,
            "search_enabled": search_engine is not None,
            "learned_topics": learned
        }


reasoning = ReasoningEngine()
