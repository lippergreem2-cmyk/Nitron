try:
    logging.basicConfig(
        filename=str(LOG_FILE),
        level=logging.INFO,
        format="%(asctime)s [%(levelname)s] %(message)s",
    )
except Exception:
    pass


def log(message, level="info"):
    try:
        logger = getattr(logging, level, logging.info)
        logger(str(message))
    except Exception:
        pass


