# ==========================================================
# OPTIONAL MODULE LOADER
# ==========================================================

def load_optional(
    module_name,
    attribute_name=None,
    label=None
):
    try:

        module = __import__(
            module_name,
            fromlist=(
                [attribute_name]
                if attribute_name
                else ["*"]
            )
        )

        if attribute_name:
            value = getattr(
                module,
                attribute_name
            )
        else:
            value = module

        if label:
            print(
                f"[OK] {label} connected."
            )

        return value

    except Exception as error:

        if label:
            print(
                f"[WARNING] {label} unavailable."
            )

        log(
            f"{module_name}: {error}",
            "warning"
        )

        return None


