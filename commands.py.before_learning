# ==========================================================
# SAFE PROJECT NAME
# ==========================================================

def safe_project_name(name):

    if not name:
        return "NitronProject"

    value = str(name).strip()

    value = re.sub(
        r"[^a-zA-Z0-9_-]+",
        "_",
        value
    )

    value = re.sub(
        r"_+",
        "_",
        value
    )

    value = value.strip("_")

    return (
        value[:80]
        if value
        else "NitronProject"
    )


