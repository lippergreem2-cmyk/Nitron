    if project_type == "web":

        for directory in (
            "frontend",
            "frontend/src",
            "frontend/public",
            "frontend/components",
            "frontend/pages",
            "frontend/styles",
            "backend",
            "backend/api",
            "backend/routes",
            "backend/models",
            "backend/services",
            "database",
            "docs",
            "tests"
        ):

            (
                project_dir / directory
            ).mkdir(
                parents=True,
                exist_ok=True
