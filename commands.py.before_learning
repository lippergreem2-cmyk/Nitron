def extract_build_request(command):

    prefixes = (
        "build ",
        "create project ",
        "make project ",
        "make a project ",
        "develop "
    )

    for prefix in prefixes:

        if command.startswith(prefix):

            request = command[
                len(prefix):
            ].strip()

            if request:
                return request

    return None


