def battery_status():

    try:

        result = subprocess.run(
            [
                "termux-battery-status"
            ],
            capture_output=True,
            text=True,
            timeout=5,
            check=False
        )

        if result.returncode != 0:

            return (
                "I couldn't read the battery status. "
                "Make sure Termux:API is installed."
            )

        data = json.loads(
            result.stdout
        )

        percentage = data.get(
            "percentage",
            "unknown"
        )

        status = data.get(
            "status",
            "unknown"
        )

        plugged = data.get(
            "plugged",
            "unknown"
        )

        temperature = data.get(
            "temperature",
            "unknown"
        )

        return (
            "Battery status:\n"
            f"Level: {percentage}%\n"
            f"Status: {status}\n"
            f"Power: {plugged}\n"
            f"Temperature: {temperature}°C"
        )

    except FileNotFoundError:

        return (
            "Termux:API is not available."
        )

    except Exception as error:

        log(
            f"Battery error: {error}",
            "error"
        )

        return "I couldn't read the battery."


