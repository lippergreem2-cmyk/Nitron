def build_project(request):

    request = str(
        request
    ).strip()

    if not request:
        return "Tell me what you want me to build."

    project_type = detect_project_type(
        request
    )

    result = ai_build_project(
        request
    )

    if result:
        return result

    result = manager_build_project(
        request,
