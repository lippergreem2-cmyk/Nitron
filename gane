import random

def play_game():
    print("Nitron Project")
    print("Guess the number!")

    target = random.randint(1, 10)

    while True:
        try:
            guess = int(input("Choose a number from 1 to 10: "))
        except ValueError:
            print("Please enter a number.")
            continue

        if guess == target:
            print("You win!")
            break

        if guess < target:
            print("Too low.")
        else:
            print("Too high.")


if __name__ == "__main__":
    play_game()
