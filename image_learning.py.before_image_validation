"""
Nitron Image Learning

Receives an image, saves it, analyzes basic image information,
and stores the result in Nitron's learning memory.
"""

import base64
import os
import uuid
from datetime import datetime

from brain.learner import learner
from ai.image_analyzer import analyze_image


IMAGE_DIR = os.path.join(
    os.path.dirname(__file__),
    "brain",
    "learned_images"
)

os.makedirs(IMAGE_DIR, exist_ok=True)


def learn_image(image_base64, filename="image.jpg", note=""):
    if not image_base64:
        raise ValueError("No image data received.")

    # Remove a possible data-URL prefix.
    if "," in image_base64:
        image_base64 = image_base64.split(",", 1)[1]

    try:
        image_data = base64.b64decode(
            image_base64,
            validate=True
        )
    except Exception as e:
        raise ValueError(
            f"Invalid image data: {e}"
        )

    extension = os.path.splitext(filename)[1].lower()

    if extension not in (
        ".jpg",
        ".jpeg",
        ".png",
        ".webp",
    ):
        extension = ".jpg"

    image_id = uuid.uuid4().hex

    saved_name = f"{image_id}{extension}"

    image_path = os.path.join(
        IMAGE_DIR,
        saved_name
    )

    with open(image_path, "wb") as file:
        file.write(image_data)

    topic = f"image_{image_id}"

    # Analyze the saved image.
    try:
        analysis = analyze_image(image_path)
    except Exception as e:
        analysis = {
            "type": "image",
            "path": image_path,
            "filename": filename,
            "analysis": (
                f"Image was saved, but analysis failed: {e}"
            )
        }

    description = analysis.get(
        "analysis",
        "Image received successfully."
    )

    if note:
        description = (
            f"{description}\n\n"
            f"User note: {note}"
        )

    content = {
        "type": "image",
        "title": filename,
        "image_path": image_path,
        "note": note,
        "description": description,
        "analysis": analysis,
        "learned_at": datetime.now().isoformat(),
    }

    entry = learner.learn(
        topic,
        "user_image",
        content
    )

    return {
        "topic": topic,
        "image_path": image_path,
        "analysis": analysis,
        "entry": entry,
    }
