"risk management": {
  "definition": "Risk management is the process of protecting your trading capital by controlling losses.",
  "notes": [
    "Never risk more than 1% to 2% of your account on a single trade.",
    "Always use a stop loss.",
    "Avoid overtrading.",
    "Protecting capital is more important than making quick profits."
